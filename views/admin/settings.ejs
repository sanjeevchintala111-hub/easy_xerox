<%- include('../partials/header') %>

<section class="section narrow">
  <div class="section-heading center">
    <span class="badge">Settings</span>
    <h1>Pricing & Admin Settings</h1>
    <p>Update Xerox rates, discount rule, UPI ID, and WhatsApp number.</p>
  </div>

  <form method="POST" action="/admin/settings" class="form card">
    <h2>Shop Settings</h2>
    <div class="form-grid two">
      <label>
        Shop/Admin Name
        <input name="shopName" value="<%= settings.shopName %>" required />
        <small>This name appears on the website and payment QR.</small>
      </label>
      <label>
        WhatsApp Support Number
        <input name="whatsappNumber" value="<%= settings.whatsappNumber %>" required />
        <small>Use country code. Example: 919876543210</small>
      </label>
      <label class="full">
        UPI ID
        <input name="upiId" value="<%= settings.upiId %>" required />
        <small>Example: yourname@upi. Do not store secret bank credentials here.</small>
      </label>
    </div>

    <h2>Pricing</h2>
    <div class="form-grid two">
      <label>
        Single Side Per Page Cost
        <input type="number" step="0.01" min="0" name="singleSideRate" value="<%= settings.singleSideRate %>" required />
        <small>Price per page for single side black & white.</small>
      </label>
      <label>
        Double Side Per Page Cost
        <input type="number" step="0.01" min="0" name="doubleSideRate" value="<%= settings.doubleSideRate %>" required />
        <small>Price per page for double side black & white.</small>
      </label>
      <label>
        4-in-1 Per Page Cost
        <input type="number" step="0.01" min="0" name="fourInOneRate" value="<%= settings.fourInOneRate %>" required />
        <small>Price per original page for 4 pages in 1 sheet.</small>
      </label>
      <label>
        Color Print Per Page Cost
        <input type="number" step="0.01" min="0" name="colorRate" value="<%= settings.colorRate %>" required />
        <small>Used when customer selects color Xerox.</small>
      </label>
      <label>
        Minimum Order Amount
        <input type="number" step="0.01" min="0" name="minimumOrderAmount" value="<%= settings.minimumOrderAmount %>" required />
        <small>Set 0 if not needed.</small>
      </label>
    </div>

    <h2>Discount Rule</h2>
    <div class="form-grid three-cols">
      <label>
        Discount Percentage
        <input type="number" step="0.01" min="0" name="discountPercentage" value="<%= settings.discountPercentage %>" required />
        <small>Example: 10 means 10% off.</small>
      </label>
      <label>
        Minimum PDF Count
        <input type="number" min="0" name="discountMinPdfs" value="<%= settings.discountMinPdfs %>" required />
        <small>Example: 10 PDFs.</small>
      </label>
      <label>
        Minimum Pages Per PDF
        <input type="number" min="0" name="discountMinPagesPerPdf" value="<%= settings.discountMinPagesPerPdf %>" required />
        <small>Example: each PDF must have 50 pages.</small>
      </label>
    </div>

    <button class="btn primary full-width" type="submit">Update Settings</button>
  </form>
</section>

<%- include('../partials/footer') %>
