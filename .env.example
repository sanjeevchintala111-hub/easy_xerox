PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/college-xerox
SESSION_SECRET=replace_with_a_long_random_secret

# Demo admin login. For production, prefer ADMIN_PASSWORD_HASH.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Recommended secure option:
# Run: npm run hash:password -- yourStrongPassword
# Then paste the output here and remove ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=$2a$10$example_hash_here

MAX_FILE_SIZE_MB=20
